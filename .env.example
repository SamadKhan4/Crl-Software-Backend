NODE_ENV=development
PORT=5000

# Use a MongoDB replica set (or Atlas) for transaction-safe workflows.
MONGODB_URI=mongodb://127.0.0.1:27017/crl_transport?replicaSet=rs0

# Comma-separated origins. Never use * in production.
CORS_ORIGIN=http://localhost:5173

# Replace each with a different randomly generated 32+ character secret.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Local secure storage (not served as a public static directory).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
UPLOAD_TOKEN_MINUTES=20

# Required only when STORAGE_DRIVER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Development seed only. Never use this default in production.
SEED_ADMIN_PASSWORD=ChangeThisDevelopmentPassword123!

# Per-process MongoDB pool and queue limits. Budget total connections across replicas.
MONGO_MAX_POOL_SIZE=30
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=30000

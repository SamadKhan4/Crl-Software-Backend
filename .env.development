NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/crl_transport?replicaSet=rs0
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=local-development-access-secret-do-not-deploy
JWT_REFRESH_SECRET=local-development-refresh-secret-do-not-deploy
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
UPLOAD_TOKEN_MINUTES=20
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MONGO_MAX_POOL_SIZE=30
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=30000
